# ===================== 哪吒监控 Agent 配置示例 =====================
# 复制为 config.yml 放在 nezha-agent 二进制同目录;或直接用 install.sh
# 自动生成。字段亦可用环境变量覆盖,前缀 NZ_(如 NZ_SERVER、NZ_CLIENT_SECRET)。
# ===================================================================

server: localhost:8008          # Dashboard 地址 host:port(与 gRPC 复用同端口)
client_secret: ""               # 必填:需与 Dashboard 的 agent_secret_key 一致
uuid: ""                        # 留空时 agent 首次启动本地生成并写回(配置只读挂载时请手动填写)
tls: false                      # 与面板通信是否启用 TLS(面板在反代后启用 https 时设 true)
insecure_tls: false             # 跳过 TLS 证书校验(自签证书时使用)

debug: false
report_delay: 1                 # 基础信息上报间隔(秒,1~4,越小越实时越耗资源)
ip_report_period: 1800          # 公网 IP 上报周期(秒)
skip_connection_count: false    # 跳过 TCP 连接数统计(高并发机器可设 true 省资源)
skip_procs_count: false         # 跳过进程数统计
disable_auto_update: false      # 关闭自动更新(容器部署 / 内网管控时建议 true)
disable_force_update: false     # 关闭面板下发的强制更新
disable_send_query: false       # 关闭主动 TCP/ICMP/HTTP 拨测
use_ipv6_country_code: false    # 优先以 IPv6 判定国家/地区
self_update_period: 0           # 自动更新检查周期(分钟,0 = 随机 1440~2880)

# 自定义获取公网 IP 的接口(留空用内置列表)
# custom_ip_api:
#   - https://api.myip.com
# 仅统计这些网卡(留空 = 全部)
# nic_allowlist:
#   eth0: true
# 仅统计这些磁盘分区挂载点(留空 = 全部)
# hard_drive_partition_allowlist:
#   - /
# 自定义 DNS 解析服务器(留空用内置)
# dns:
#   - 1.1.1.1:53
